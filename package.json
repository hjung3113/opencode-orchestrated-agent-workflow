    "test:m4-capabilities": "node --test test/m4-opencode-capabilities.test.mjs",
    "test:m4-workflow-routes": "node --test test/m4-workflow-routes.test.mjs",
    "test:m4-attempt-profiles-replan": "node --test test/m4-attempt-profiles-replan.test.mjs",
    "test:m4-operator": "node --test test/m4-operator.test.mjs",
